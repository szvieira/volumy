<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Volumy.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Volumy">

    <!-- Our own dark glass tray menu (replaces H.NotifyIcon's SecondWindow menu, which crashed). -->
    <Grid x:Name="Root" RequestedTheme="Dark" VerticalAlignment="Top" Background="#C81C1C21"
          BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="5,6" KeyDown="Root_KeyDown" SizeChanged="Root_SizeChanged">
        <StackPanel x:Name="Items" Spacing="1" />
    </Grid>
</Window>

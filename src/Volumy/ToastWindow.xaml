<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Volumy.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Volumy">

    <!-- Backdrop is set in code so the acrylic stays on while the toast is not focused. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#99141418" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0"
          Padding="16,0,18,0" ColumnSpacing="14" Opacity="0" Tapped="Root_Tapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="InitialCircle" Width="44" Height="44" CornerRadius="22" Background="#E6FFFFFF" VerticalAlignment="Center">
            <TextBlock x:Name="InitialText" Foreground="#111114" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MessageText" FontSize="13" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="LevelBar" Maximum="100" Height="4" MinHeight="4" CornerRadius="2" Margin="0,6,0,0"
                         Foreground="#F2FFFFFF" Background="#2EFFFFFF" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Volumy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Neutral palette: sliders are white; app sliders get their icon color in code. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#47FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE5E5EA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#47FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE5E5EA" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Tray menu: dark glass panel (Raycast-like), always dark regardless of the Windows theme. -->
            <Style x:Key="GlassMenuPresenter" TargetType="MenuFlyoutPresenter">
                <Setter Property="RequestedTheme" Value="Dark" />
                <Setter Property="Background" Value="#F01C1C21" />
                <Setter Property="BorderBrush" Value="#2EFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="MinWidth" Value="260" />
            </Style>

            <!-- Glass card: translucent fill, light top edge. -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="#17FFFFFF" />
                <Setter Property="BorderBrush" Value="#29FFFFFF" />
                <Setter Property="BorderThickness" Value="1,1,1,0.5" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="BorderBrush" Value="#2EFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="PrimaryGlassButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Background" Value="#EBFFFFFF" />
                <Setter Property="Foreground" Value="#111114" />
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Volumy.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Volumy.ViewModels"
    xmlns:loc="using:Volumy.Localization"
    xmlns:ui="using:Volumy.Interop"
    Title="Volumy">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Darker tint than before so text behind the window doesn't bleed through. -->
    <Grid x:Name="Root" VerticalAlignment="Top" SizeChanged="Root_SizeChanged" RequestedTheme="Dark" Background="#B3141418" Padding="14,12,14,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, save, settings -->
        <Grid Grid.Row="0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind loc:S.Audio}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
            <ui:HandButton Grid.Column="1" Style="{StaticResource GlassIconButton}" Click="Save_Click"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.SaveLabel, Mode=OneWay}">
                <FontIcon Glyph="&#xE74E;" FontSize="15" />
            </ui:HandButton>
            <ui:HandButton Grid.Column="2" Style="{StaticResource GlassIconButton}" Click="EditProfiles_Click"
                    ToolTipService.ToolTip="{x:Bind loc:S.ConfigureProfiles}" AutomationProperties.Name="{x:Bind loc:S.ConfigureProfiles}">
                <FontIcon Glyph="&#xE713;" FontSize="15" />
            </ui:HandButton>
        </Grid>

        <!-- Profiles: segmented capsule -->
        <StackPanel Grid.Row="1" Spacing="4">
            <Border Background="#33000000" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="22" Padding="3">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Up to 4 chips (the active one is always shown, with its name); the rest go in the "+N" dropdown. -->
                    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileChip">
                                    <ui:HandButton Tag="{x:Bind Id}" Click="ProfileChip_Click" Padding="0" MinHeight="38"
                                            ToolTipService.ToolTip="{x:Bind Name}"
                                            Background="Transparent" BorderThickness="0" CornerRadius="19"
                                            PointerEntered="Chip_PointerEntered" PointerExited="Chip_PointerExited">
                                        <!-- Our own hover (on the inner border) replaces the default grey button highlight. -->
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </Button.Resources>
                                        <Border Background="{x:Bind Background, Mode=OneWay}" BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                                                BorderThickness="1" CornerRadius="19" Padding="{x:Bind ChipPadding, Mode=OneWay}" MinHeight="38">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{x:Bind CircleBrush}">
                                                    <TextBlock Text="{x:Bind Initial}" Foreground="#111114" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- Only the active profile shows its name; the others are colored initials (name on hover). -->
                                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                                                           Visibility="{x:Bind NameVisibility, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                            </StackPanel>
                                        </Border>
                                    </ui:HandButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ui:HandButton x:Name="OverflowButton" Grid.Column="1" Click="OverflowButton_Click"
                            Visibility="{x:Bind ViewModel.OverflowVisibility, Mode=OneWay}"
                            MinHeight="38" Padding="10,0" CornerRadius="19" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                            ToolTipService.ToolTip="{x:Bind loc:S.MoreProfiles}" AutomationProperties.Name="{x:Bind loc:S.MoreProfiles}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.OverflowText, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:HandButton>
                    <ui:HandButton Grid.Column="2" Style="{StaticResource GlassIconButton}" Width="38" Height="38"
                            Background="Transparent" BorderThickness="0"
                            Visibility="{x:Bind ViewModel.NewButtonVisibility, Mode=OneWay}"
                            Click="NewProfile_Click" ToolTipService.ToolTip="{x:Bind loc:S.NewProfileFromCurrent}"
                            AutomationProperties.Name="{x:Bind loc:S.NewProfile}">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </ui:HandButton>
                </Grid>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Output + microphone, compact: device picker line above its slider -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="10,8,10,8">
            <StackPanel Spacing="2">
                <ui:HandComboBox ItemsSource="{x:Bind ViewModel.Outputs}" SelectedIndex="{x:Bind ViewModel.OutputIndex, Mode=OneWay}"
                          SelectionChanged="Output_SelectionChanged" HorizontalAlignment="Stretch" MinHeight="32"
                          Background="Transparent" BorderThickness="0" CornerRadius="8" FontSize="13"
                          AutomationProperties.Name="{x:Bind loc:S.OutputDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ui:HandComboBox>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <ui:HandButton Style="{StaticResource GlassIconButton}" Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Click="OutputMute_Click" AutomationProperties.Name="{x:Bind loc:S.MuteOutput}">
                        <FontIcon Glyph="{x:Bind ViewModel.OutputGlyph, Mode=OneWay}" FontSize="15" />
                    </ui:HandButton>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Slider Maximum="100" PointerWheelChanged="Slider_PointerWheelChanged"
                                Value="{x:Bind ViewModel.OutputVolume, Mode=TwoWay}" AutomationProperties.Name="{x:Bind loc:S.OutputVolume}" />
                        <!-- Live level: what is actually playing right now -->
                        <Rectangle Height="2" RadiusX="1" RadiusY="1" Fill="#8CFFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                     Margin="2,0,2,2" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <!-- Grows from the left edge only: scaled, never moved -->
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind ViewModel.OutputPeakScale, Mode=OneWay}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.OutputVolumeText, Mode=OneWay}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="13" Opacity="0.85" />
                </Grid>

                <Rectangle Height="1" Fill="#1FFFFFFF" Margin="0,4" />

                <ui:HandComboBox ItemsSource="{x:Bind ViewModel.Inputs}" SelectedIndex="{x:Bind ViewModel.InputIndex, Mode=OneWay}"
                          SelectionChanged="Input_SelectionChanged" HorizontalAlignment="Stretch" MinHeight="32"
                          Background="Transparent" BorderThickness="0" CornerRadius="8" FontSize="13"
                          AutomationProperties.Name="{x:Bind loc:S.Microphone}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="14" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ui:HandComboBox>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <ui:HandButton Style="{StaticResource GlassIconButton}" Width="36" Height="36" Background="Transparent" BorderThickness="0"
                            Click="InputMute_Click" AutomationProperties.Name="{x:Bind loc:S.MuteMicrophone}">
                        <FontIcon Glyph="{x:Bind ViewModel.InputGlyph, Mode=OneWay}" FontSize="15" />
                    </ui:HandButton>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Slider Maximum="100" PointerWheelChanged="Slider_PointerWheelChanged"
                                Value="{x:Bind ViewModel.InputVolume, Mode=TwoWay}" AutomationProperties.Name="{x:Bind loc:S.MicrophoneVolume}" />
                        <!-- Live level: moves when the mic picks you up -->
                        <Rectangle Height="2" RadiusX="1" RadiusY="1" Fill="#8CFFFFFF" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                     Margin="2,0,2,2" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                            <!-- Grows from the left edge only: scaled, never moved -->
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind ViewModel.InputPeakScale, Mode=OneWay}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.InputVolumeText, Mode=OneWay}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="13" Opacity="0.85" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="8,2,8,-4">
            <TextBlock Text="{x:Bind loc:S.Apps}" FontSize="13" FontWeight="SemiBold" Opacity="0.85" />
            <TextBlock Text="{x:Bind ViewModel.AppCountText, Mode=OneWay}" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
        </Grid>

        <!-- Apps: grows with the app count, scrolls after 5 rows (5 x 52) -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="10,2,4,2" MinHeight="56">
            <Grid>
                <TextBlock Text="{x:Bind loc:S.NoApps}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.NoAppsVisibility, Mode=OneWay}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" MaxHeight="260">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppItem">
                                <Grid ColumnSpacing="10" Height="52" Padding="6,0,0,0" Margin="-6,0,0,0" CornerRadius="12"
                                      Background="Transparent" PointerEntered="AppRow_PointerEntered" PointerExited="AppRow_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#1AFFFFFF" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Letters}" FontSize="10" FontWeight="Bold" Opacity="0.8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind Icon}" Width="24" Height="24" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,36,-4" />
                                        <TextBlock Text="{x:Bind VolumeText, Mode=OneWay}" HorizontalAlignment="Right" FontSize="12"
                                                   Opacity="0.8" Margin="0,0,0,-4" />
                                        <Grid Grid.Row="1">
                                            <Slider Maximum="100" Loading="AppSlider_Loading" PointerWheelChanged="Slider_PointerWheelChanged"
                                                    Value="{x:Bind Volume, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" />
                                            <Rectangle Height="2" RadiusX="1" RadiusY="1" Fill="{x:Bind Accent}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                     Margin="2,0,2,2" IsHitTestVisible="False" RenderTransformOrigin="0,0.5" Opacity="0.75">
                            <!-- Grows from the left edge only: scaled, never moved -->
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind PeakScale, Mode=OneWay}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                                        </Grid>
                                    </Grid>
                                    <ui:HandButton Grid.Column="2" Style="{StaticResource GlassIconButton}" Width="36" Height="36"
                                            Background="Transparent" BorderThickness="0"
                                            Click="AppMute_Click" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind loc:S.Mute}">
                                        <FontIcon Glyph="{x:Bind MuteGlyph, Mode=OneWay}" FontSize="15" />
                                    </ui:HandButton>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
